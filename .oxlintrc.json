{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "jsx-a11y", "import"],
  "categories": { "correctness": "error" },
  "ignorePatterns": [
    "**/dist/**",
    "**/generated/**",
    "**/.agents/**",
    "node_modules/**",
    ".yarn/**"
  ]
}
