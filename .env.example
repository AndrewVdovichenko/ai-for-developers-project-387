# Local Apple Container only. Production requires a secret DATABASE_URL and HTTPS.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/calendar
APP_ORIGIN=http://127.0.0.1:5173
# Explicit trusted proxy IPs/CIDRs, comma separated; empty means no trusted proxies.
TRUSTED_PROXIES=
# Test runner creates and drops a random database on this server.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postgres
