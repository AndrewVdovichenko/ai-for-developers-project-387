amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"

hooks {
  ["pre-commit"] {
    steps {
      ["format"] {
        glob = List("**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,md,toml}")
        exclude = List("**/generated/**", ".github/workflows/hexlet-check.yml", "**/.agents/**")
        check = "yarn exec oxfmt --check {{files}}"
      }
      ["lint"] {
        glob = List("**/*.{ts,tsx,js,mjs,cjs}")
        exclude = List("**/generated/**", "**/.agents/**")
        check = "yarn exec oxlint --deny-warnings {{files}}"
      }
      ["secrets"] {
        check = "betterleaks git --staged --redact"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["check"] { check = "mise run check" }
    }
  }
}
